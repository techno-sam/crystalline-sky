{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${version}",
  "name": "${modName}",
  "description": "${modDescription}",
  "authors": [
    "${authors}"
  ],
  "contributors": [
    "${contributors}"
  ],
  "contact": {
    "homepage": "${homepage}",
    "issues": "${issues}",
    "sources": "${sources}"
  },
  "license": "${license}",
  "icon": "assets/${modId}/icon.png",
  "mixins": [
    "${modId}.mixins.json",
    "${modId}-common.mixins.json"
  ],
  "depends": {
    "minecraft": ">=${mc}",
    "fabricloader": ">=${fl}",
    "fabric-api": ">=${fapi}"
  },
  "suggests": {
  },
  "entrypoints": {
    "main": [
      "io.github.slimeistdev.crystalline_sky.fabric.CrystallineSkyImpl"
    ],
    "client": [
      "io.github.slimeistdev.crystalline_sky.fabric.CrystallineSkyClientImpl"
    ],
    "fabric-datagen": [
      "io.github.slimeistdev.crystalline_sky.fabric.datagen.CrystallineSkyDataGenerator"
    ]
  }
}
